# ==========================================
# CodeBuddy AI - Environment Configuration
# ==========================================

# ------------------------------------------
# Google Gemini & Gemma 4 API Configuration (Recommended)
# ------------------------------------------
# Get your free Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemma Model configuration (default: gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it

# ------------------------------------------
# Alternative / Fallback Providers
# ------------------------------------------
# OpenAI / OpenRouter API Key (Optional fallback)
# Leave empty or unset to automatically run in Smart Demo Mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ------------------------------------------
# Server Configuration
# ------------------------------------------
# Flask Server Port
PORT=5000

# Flask Environment (development / production)
FLASK_ENV=development
