# Copy this file to ".env" and fill in your key:   copy .env.example .env
# NEVER commit the real .env file. It is already listed in .gitignore.

# Get a key at https://platform.openai.com/api-keys
# Leave it as-is (or empty) to run in DEMO MODE with sample responses.
OPENAI_API_KEY=your_openai_api_key_here

# Optional settings
OPENAI_MODEL=gpt-4o-mini
PORT=5000
FLASK_DEBUG=0
# Set to 1 to force demo mode even when a key is present
CODEBUDDY_DEMO=0
